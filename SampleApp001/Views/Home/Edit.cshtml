@model Songapp.ViewModel.SongEditViewModel //SongEditViewModel というデータ構造（箱）を使用することを宣言
@{
    // Ｉｄが0なら「追加ページ」、それ以外なら「編集ページ」とタブのタイトルを自動切替    ViewData["Title"] = Model.Id == 0 ? "Create Page" : "Edit Page";
}
<div class="container mt-4" style="max-width: 600px;">
    <div class="card shadow">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                @if (Model.Id == 0)
                {
                    <h2 class="mb-0" data-comment="Ｉｄが0（新規追加）の時に表示する見出し">楽曲追加</h2>
                }
                else
                {
                    <h2 class="mb-0" data-comment="Ｉｄが0以外（既存データの変更）の時に表示する見出し">楽曲管理</h2>
                }
                <button type="button" class="btn btn-outline-secondary btn-sm" onclick="history.back()" data-comment="前の画面に戻る処理">戻る</button>
            </div>
            <form method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <div class="mb-3">
                    <label class="form-label">曲名</label>
                    <input type="text" asp-for="Edit_Song" class="form-control" placeholder="曲名を入力してください" />
                    <div class="mt-1">
                        <span asp-validation-for="Edit_Song" class="text-danger small"></span>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">グループ名</label>
                    <input type="text" asp-for="Edit_Group" class="form-control" placeholder="グループ名を入力してください" />
                    <div class="mt-1">
                        <span asp-validation-for="Edit_Group" class="text-danger small"></span>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">作者名</label>
                    <input type="text" asp-for="Edit_Artist" class="form-control" placeholder="作者名を入力してください" />
                    <div class="mt-1">
                        <span asp-validation-for="Edit_Artist" class="text-danger small"></span>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">年代</label>
                    <input type="text" asp-for="Edit_History" class="form-control" placeholder="年代を入力してください" />
                    <div class="mt-1">
                        <span asp-validation-for="Edit_History" class="text-danger small"></span>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">歌詞</label>
                    <textarea asp-for="Edit_Lyric" class="form-control" rows="6" placeholder="歌詞を入力してください" data-comment="複数行の改行入力に対応した大きめのテキストエリア領域"></textarea>
                    <div class="mt-1">
                        <span asp-validation-for="Edit_Lyric" class="text-danger small"></span>
                    </div>
                </div>
                <div class="d-flex gap-2 mt-4 pt-3 border-top">
                    @if (Model.Id == 0)
                    {
                        <input type="submit" class="btn btn-primary flex-grow-1" value="追加する" asp-action="Edit" onclick="return confirm('この内容で追加しますか？')" data-comment="新規追加の時は、青い「追加する」ボタンを表示" />
                    }
                    else
                    {
                        <input type="submit" class="btn btn-success flex-grow-1" value="変更する" asp-action="Edit" onclick="return confirm('この内容で変更しますか？')" data-comment="変更の時は、緑の「変更する」ボタンを表示" />
                        <input type="submit" class="btn btn-danger" value="削除する" asp-action="Delete" onclick="return confirm('本当に削除しますか？')" data-comment="変更の時だけ「削除する」ボタンを表示（追加の時は非表示）" />
                    }
                </div>
            </form>
        </div>
    </div>
</div>