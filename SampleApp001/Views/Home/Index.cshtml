@model Songapp.ViewModel.SongIndexViewModel //画面で使うviewmodelの指定
@{
    ViewData["Title"] = "Song Page";
}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0" data-comment="画面の大見出しとして楽曲検索と表示">楽曲検索</h2>
        <div class="alert alert-info">こんにちは：@Context.Session.GetString("LoginUser")さん</div>
        <a asp-action="Edit" asp-route-id="0" class="btn btn-success" data-comment="新規追加画面へ移動するためのボタンリンク">追加はこちら</a>
    </div>
    <form method="get">
        <div class="row g-2 mb-4">
            <div class="col-md-6 col-lg-4">
                <div class="input-group">
                    <input type="text" asp-for="Keyword" class="form-control" placeholder="キーワードを入力してください" data-comment="キーワードを入力するためのテキストボックス" />
                    <input type="submit" class="btn btn-primary" value="検索" data-comment="検索を実行するための送信ボタン" />
                </div>
                <div class="mt-1">
                    <span asp-validation-for="Keyword" class="text-danger small" data-comment="キーワードの入力欄にエラーがあった場合にエラーメッセージを赤い文字で表示"></span>
                </div>
            </div>
        </div>
        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" style="table-layout: fixed; width: 100%;" data-comment="楽曲一覧を表示するための表を作成">
                    <thead class="table-light">
                        <tr>
                            <th>曲名</th>
                            <th>グループ</th>
                            <th>作曲者</th>
                            <th>年代</th>
                            <th style="width: 80px;">詳細</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Songs)
                        {
                            <tr data-comment="データベースから取得した楽曲リストの中身をC#のforeachを使って1件ずつ取り出して繰り返す">
                                <td class="fw-bold text-truncate">@item.Song</td>
                                <td>@item.Group</td>
                                <td>@item.Artist</td>
                                <td>@item.History</td>
                                <td>
                                    <button type="button" class="btn btn-outline-secondary btn-sm" onclick="slide(this, @item.Id)" data-comment="詳細エリアを開閉するための下向き矢印ボタン">⇩</button>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="5" class="p-0 border-bottom-0">
                                    <div id="detail@(item.Id)" class="bg-light p-3 border-top border-bottom" style="display:none;" data-comment="楽曲ごとID名が自動で割り振られる詳細エリア">
                                        
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <strong class="text-muted small">歌詞</strong>
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-success" data-comment="詳細エリアの中にその曲を編集するための変更するボタンを設置">変更する</a>
                                        </div>

                                        <div class="mb-3">
                                            <div class="text-secondary" style="white-space: pre-line; word-break: break-all;">@item.Lyric</div>
                                        </div>

                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        function slide(btn,id){
            $('#detail'+id).slideToggle(function(){// 1. 対象の詳細エリア（#detail+ID）の表示・非表示をアニメーション付きで切り替える
                if ($('#detail'+id).is(':visible')) {// 2. アニメーション完了後、現在の表示状態（見えているかどうか）を判定
                    $(btn).text('⇧');// 見えているなら、ボタンの文字を⇧にする
                } else {
                    $(btn).text('⇩'); // 見えていないなら、ボタンの文字を⇩にする
                }
            })
        }
    </script>
}