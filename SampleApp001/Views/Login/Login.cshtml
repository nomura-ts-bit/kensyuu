@model Songapp.ViewModel.LoginViewModel

@{
    ViewData["Title"] = "Login Page";
    Layout = null;
}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
<h2>ログイン</h2>
<div asp-validation-summary="All" class="text-danger">
</div>
<form method="post">
    @Html.AntiForgeryToken()
    <div>
        <label>ユーザー名</label>
        <input type="text" asp-for="Username" placeholder="ユーザー名を入力してください" />
    </div>
    <div>
        <label>パスワード</label>
        <input type="password" asp-for="Password" placeholder="パスワードを入力してください" />
    </div>
    <input type="submit" class="btn btn-primary" value="ログイン" />
    <div>
        <label>新規作成はこちら</label>
    </div>
    <div>
        <a asp-action="Edit">新規作成</a>
    </div>

</form>


