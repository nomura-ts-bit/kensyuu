@model Songapp.ViewModel.LoginViewModel // 【設計図】この画面で使うデータの設計図を指定 

@{
    ViewData["Title"] = "Login Page";    // 【画面タイトル】ブラウザのタブに表示される名前を設定 
    Layout = null;                      // 【デザイン枠】共通メニューを使わず単体で画面を作る設定 
}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" /> <!--Bootstrapの読み込み -->

<h2>ログイン</h2>                        <!-- 画面のタイトル -->

<div asp-validation-summary="All" class="text-danger"></div> <!--入力エラーやパスワード間違いをまとめて表示 -->

<form method="post">                     <!-- 入力内容をまとめてサーバーへ送る -->
    @Html.AntiForgeryToken()            <!-- 不正アクセスを弾く -->
    <div>                               <!-- ユーザー名の項目をひとかたまりにする -->
        <label>ユーザー名</label>        <!-- 入力欄が何の項目なのかを表す -->
        <input type="text" asp-for="Username" placeholder="ユーザー名を入力してください" /> <!-- Usernameと直結 -->
    </div>
    <div>                               
        <label>パスワード</label>       
        <input type="password" asp-for="Password" placeholder="パスワードを入力してください" /> <!-- Passwordと直結(typeにより伏字化) -->
    </div>
    <input type="submit" class="btn btn-primary" value="ログイン" /> <!-- 入力された情報でログイン処理を実行 -->
    <div>                               
        <label>新規作成はこちら</label>  
    </div>
    <div>                              
        <a asp-action="Edit">新規作成</a> <!-- 新規登録画面（Edit）へ切り替わるリンク -->
    </div>
</form>