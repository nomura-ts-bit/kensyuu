@model Songapp.ViewModel.LoginViewModel

@{
    ViewData["Title"] = "Edit Page";
    Layout = null;
}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
<h2>
    新規登録
    <button type="button" class="btn btn-link text-decoration-underline" onclick="history.back()">ログイン</button>
</h2>

<form method="post">
    @Html.AntiForgeryToken()
    <div>
        <label>ユーザー名</label>
        <input type="text" asp-for="Username" placeholder="ユーザー名を入力してください" />
    </div>
    <div>
        <label>パスワード</label>
        <input type="password" asp-for="Password" placeholder="パスワードを入力してください" />
    </div>
    <input type="submit" class="btn btn-primary" value="新規作成" asp-action="Edit" />

</form>


