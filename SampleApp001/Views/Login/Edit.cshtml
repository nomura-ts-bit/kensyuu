@model Songapp.ViewModel.LoginViewModel // 画面で使うviewmodelの指定 

@{
    ViewData["Title"] = "Edit Page";    <!-- ブラウザのタブに表示される名前を設定 -->
    Layout = null;                      <!-- 共通メニューを使わず単体で画面を作る設定 -->
}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" /> <!-- Bootstrapの読み込み -->

<h2>                                    <!-- 画面のタイトル -->
    新規登録
    <button type="button" class="btn btn-link text-decoration-underline" onclick="history.back()">ログイン</button> <!-- 1つ前の画面に戻る -->
</h2>

<form method="post">                     <!-- 入力内容をまとめてサーバーへ送る -->
    @Html.AntiForgeryToken()            <!-- 不正アクセスを弾く処理 -->
    <div>                               <!-- ユーザー名の項目をひとかたまりにする兼改行 -->
        <label>ユーザー名</label>        <!-- 何の項目なのかを表す -->
        <input type="text" asp-for="Username" placeholder="ユーザー名を入力してください" /> <!-- Usernameと直結させるタグヘルパー -->
    </div>
    <div>                               <!-- パスワード用の項目をひとかたまりにする兼改行 -->
        <label>パスワード</label>        <!-- パスワード用を表す文字 -->
        <input type="password" asp-for="Password" placeholder="パスワードを入力してください" /> <!-- Passwordと直結させるタグヘルパー(type="password"によって伏字化) -->
    </div>
    <input type="submit" class="btn btn-primary" value="新規作成" asp-action="Edit" /> <!--コントローラーのEdit処理へデータを送る -->
</form>